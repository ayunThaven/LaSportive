# Commun
NODE_ENV=development

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://lasportive:lasportive@localhost:5432/lasportive?schema=public
JWT_SECRET=change-me-with-at-least-32-characters
APP_USERNAME=association
# Générer avec : npm run password:hash -w @la-sportive/api -- "votre mot de passe"
APP_PASSWORD_HASH=
# Autorisé uniquement pour le développement ; le serveur le hache en mémoire au démarrage.
APP_PASSWORD=change-me
DEMO_MODE=false
DEMO_USERNAME=association
DEMO_PASSWORD=demo-sportive
SYNC_CRON=*/15 * * * *

# HelloAsso
HELLOASSO_ENVIRONMENT=production
HELLOASSO_API_BASE_URL=
HELLOASSO_ORGANIZATION_SLUG=
HELLOASSO_CAMPAIGN_SLUG=
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=

# Brevo (API HTTPS, compatible avec Render gratuit)
BREVO_API_KEY=
EMAIL_FROM="La Sportive <contact@example.org>"
EMAIL_REPLY_TO=contact@example.org

# Google Drive (JSON du compte de service, encodé en base64)
GOOGLE_SERVICE_ACCOUNT_BASE64=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/api/v1/integrations/google-drive/callback

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
