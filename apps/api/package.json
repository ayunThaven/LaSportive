{
  "name": "@la-sportive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts",
    "password:hash": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@la-sportive/contracts": "0.1.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "googleapis": "^173.0.0",
    "node-cron": "^4.0.5",
    "nodemailer": "^9.0.1",
    "pg": "^8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
